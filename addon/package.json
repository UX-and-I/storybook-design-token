{
  "name": "storybook-design-token",
  "version": "5.0.0",
  "description": "Storybook addon to display design token documentation generated from your stylesheets and icon files.",
  "type": "module",
  "keywords": [
    "design token",
    "design system",
    "design pattern",
    "storybook-addon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UX-and-I/storybook-design-token"
  },
  "author": "Philipp Siekmann <philippsiekmann@me.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "default": "./dist/manager.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./doc-blocks": {
      "types": "./dist/doc-blocks.d.ts",
      "default": "./dist/doc-blocks.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "yarn clean",
    "build": "tsup & yarn build:preset",
    "build:watch": "tsup --watch",
    "build:preset": "tsup --config tsup.node.config.ts",
    "build:preset:watch": "tsup --config tsup.node.config.ts --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "run-p build:watch build:preset:watch 'storybook --quiet'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.3",
    "storybook": "^10.3.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "storybook": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "storybook": {
    "displayName": "Storybook Design Token",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact"
    ],
    "icon": "https://raw.githubusercontent.com/UX-and-I/storybook-design-token/master/docs/teaser.png"
  },
  "dependencies": {
    "@storybook/icons": "^2.0.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@uidotdev/usehooks": "^2.4.1",
    "glob": "^13.0.6",
    "jsdom": "^29.1.1",
    "polished": "^4.3.1",
    "postcss": "^8.5.14",
    "postcss-scss": "^4.0.9",
    "raw-loader": "^4.0.2"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  },
  "packageManager": "yarn@4.10.3"
}
